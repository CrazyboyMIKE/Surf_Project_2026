PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Use mock://livekit when no real LiveKit server is configured.
# For LiveKit Cloud this usually looks like wss://your-project.livekit.cloud.
LIVEKIT_URL=mock://livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=1h

MOCK_ROBOT_ONLINE=true
